{
  "name": "gt-lifecycle-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "typecheck": "vue-tsc --noEmit",
    "build": "node build.mjs",
    "build:shell": "npm run typecheck && vite build",
    "dev:viewer": "node ../vendor/turbine-explorer/node_modules/vite/bin/vite.js ../vendor/turbine-explorer --base=/viewer/ --host 127.0.0.1 --port 4177 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --strictPort",
    "test": "node tests/browser.mjs",
    "test:lifecycle": "node tests/lifecycle.mjs"
  },
  "dependencies": { "vue": "3.5.44" },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "playwright": "1.56.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vue-tsc": "3.3.14"
  }
}
